# ==============================================================================
# SISTEM PAKAR KESIAPAN ATLET MUAYTHAI PENGKOT PONTIANAK - ENVIRONMENT CONFIG
# ==============================================================================

# Database Connection (PostgreSQL on Neon / Supabase / Vercel Postgres)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sistem_pakar_muaythai?schema=public"

# Next.js App Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# AI / LLM Explanation Layer (9Router Local Gateway)
# Non-binding narrative explanation layer strictly per SRS FR-33 to FR-38
NINE_ROUTER_ENDPOINT="http://localhost:20128/v1"
AI_GATEWAY_API_KEY="your_9router_api_key_here"
AI_EXPLANATION_MODEL="MyCodeDec"

# Security & Sessions
NEXTAUTH_SECRET="muaythai-pontianak-spk-secret-key-production-change-this"
NEXTAUTH_URL="http://localhost:3001"
